#!/usr/bin/env bash
# program-fpga — Program any bitstream onto the local Genesys 2 board
#
# Usage:
#   ./program-fpga                          # programs BRAM bringup bitstream
#   ./program-fpga path/to/design.bit       # programs any bitstream
#
set -euo pipefail

VIVADO_LAB_SETTINGS="${VIVADO_LAB_SETTINGS:-/home/omar/Xilinx/2025.2.1/Vivado_Lab/settings64.sh}"
USB_WAIT_SECS="${USB_WAIT_SECS:-30}"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
# Prefer the build artifact first so the default always tracks the current tree.
# Fall back to a repo-root copy only if the build artifact is not present.
if [[ -f "$REPO_ROOT/build/fpga/vivado-bram/risky_genesys2_bram.bit" ]]; then
    DEFAULT_BIT="$REPO_ROOT/build/fpga/vivado-bram/risky_genesys2_bram.bit"
elif [[ -f "$REPO_ROOT/risky_genesys2_bram.bit" ]]; then
    echo "[program-fpga] WARNING: using repo-root bitstream fallback; prefer build/fpga/vivado-bram/risky_genesys2_bram.bit" >&2
    DEFAULT_BIT="$REPO_ROOT/risky_genesys2_bram.bit"
else
    DEFAULT_BIT="$REPO_ROOT/build/fpga/vivado-bram/risky_genesys2_bram.bit"
fi
BITSTREAM="${1:-$DEFAULT_BIT}"

if [[ ! -f "$BITSTREAM" ]]; then
    echo "ERROR: bitstream not found: $BITSTREAM" >&2
    exit 1
fi

# Source Vivado Lab if vivado_lab not already in PATH
if ! command -v vivado_lab &>/dev/null; then
    if [[ ! -f "$VIVADO_LAB_SETTINGS" ]]; then
        echo "ERROR: Vivado Lab settings not found at $VIVADO_LAB_SETTINGS" >&2
        echo "       Set VIVADO_LAB_SETTINGS env var to the correct path." >&2
        exit 1
    fi
    # shellcheck disable=SC1090
    source "$VIVADO_LAB_SETTINGS"
fi

echo "[program-fpga] programming: $BITSTREAM"

vivado_lab -mode batch -notrace \
    -source "$SCRIPT_DIR/program_local_genesys2.tcl" \
    -tclargs "$BITSTREAM"

echo "[program-fpga] waiting for Digilent USB serial to re-enumerate"
deadline=$((SECONDS + USB_WAIT_SECS))
while (( SECONDS < deadline )); do
    if ls /dev/serial/by-id/usb-Digilent_Digilent_Adept_USB_Device_* >/dev/null 2>&1; then
        echo "[program-fpga] Digilent USB serial is back"
        break
    fi
    sleep 1
done

if ! ls /dev/serial/by-id/usb-Digilent_Digilent_Adept_USB_Device_* >/dev/null 2>&1; then
    echo "[program-fpga] WARNING: Digilent USB serial did not reappear within ${USB_WAIT_SECS}s" >&2
fi

echo "[program-fpga] done — board is running $(basename "$BITSTREAM")"
