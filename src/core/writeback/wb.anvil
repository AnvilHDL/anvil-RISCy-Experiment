import "../../types/pipeline.anvilh"

// Select the writeback value. The caller applies the register-write policy
// from the packet's control bits and exception status.

func wb_value(pkt : mem_wb_pkt_t) {
    if pkt.ctrl.wb_sel == wb_sel_t::WB_MEM { pkt.mem_data }
    else if pkt.ctrl.wb_sel == wb_sel_t::WB_PC4 { pkt.pc + <(64'd4)::xlen_t> }
    else { pkt.alu_result }
}
