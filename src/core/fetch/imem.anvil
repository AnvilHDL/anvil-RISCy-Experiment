import "../../types/pipeline.anvilh"

// Hand-written instruction memory used by the M1 top-level smoke.
// The program is deliberately small but exercises:
// - ALU writeback
// - branch taken / skipped instruction
// - branch not taken
// - store then load
// - logical and arithmetic right shifts
// - x0 write suppression
// - illegal instruction trap at the end

func demo_imem_word(word_idx : logic[14]) {
    if word_idx == 14'd0 { <(32'h00500093)::instr_t> }
    else if word_idx == 14'd1 { <(32'h00700113)::instr_t> }
    else if word_idx == 14'd2 { <(32'h002081b3)::instr_t> }
    else if word_idx == 14'd3 { <(32'h00118213)::instr_t> }
    else if word_idx == 14'd4 { <(32'h00420463)::instr_t> }
    else if word_idx == 14'd5 { <(32'h06300293)::instr_t> }
    else if word_idx == 14'd6 { <(32'h00120333)::instr_t> }
    else if word_idx == 14'd7 { <(32'h00602423)::instr_t> }
    else if word_idx == 14'd8 { <(32'h00802383)::instr_t> }
    else if word_idx == 14'd9 { <(32'h00238433)::instr_t> }
    else if word_idx == 14'd10 { <(32'h00245493)::instr_t> }
    else if word_idx == 14'd11 { <(32'h00949463)::instr_t> }
    else if word_idx == 14'd12 { <(32'h4014d513)::instr_t> }
    else if word_idx == 14'd13 { <(32'h06350013)::instr_t> }
    else if word_idx == 14'd14 { <(32'hffffffff)::instr_t> }
    else { <(32'h00000013)::instr_t> }
}

func demo_imem_read(pc : xlen_t) {
    call demo_imem_word(<(pc[2+:14])::logic[14]>)
}
