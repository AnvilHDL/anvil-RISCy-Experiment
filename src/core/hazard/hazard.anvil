import "../../types/pipeline.anvilh"
import "../decode/fields.anvil"

// M1 only needs one true hazard detector: load-use.
// Branch flushes and traps are resolved directly in the top-level control flow.

func load_use_stall(if_id_pkt : if_id_pkt_t, id_ex_pkt : id_ex_pkt_t) {
    let if_rs1 = call rs1_of(if_id_pkt.fetched.instr);
    let if_rs2 = call rs2_of(if_id_pkt.fetched.instr);
    if if_id_pkt.valid == 1'b1 && id_ex_pkt.valid == 1'b1 && id_ex_pkt.ctrl.mem_read == 1'b1 && id_ex_pkt.rd != <(5'd0)::reg_idx_t> &&
       (id_ex_pkt.rd == if_rs1 || id_ex_pkt.rd == if_rs2) {
        1'b1
    } else {
        1'b0
    }
}

func control_use_stall(if_id_pkt : if_id_pkt_t, id_ex_pkt : id_ex_pkt_t, ex_mem_pkt : ex_mem_pkt_t) {
    let if_instr = if_id_pkt.fetched.instr;
    let if_rs1 = call rs1_of(if_instr);
    let if_rs2 = call rs2_of(if_instr);
    let if_ctrl = call decode_ctrl(if_instr).ctrl;
    let is_ctrl_sensitive =
        if_id_pkt.valid == 1'b1 &&
        (if_ctrl.branch_op != branch_op_t::BR_NONE || if_ctrl.is_system == 1'b1);
    let id_dep =
        id_ex_pkt.valid == 1'b1 &&
        id_ex_pkt.rd != <(5'd0)::reg_idx_t> &&
        id_ex_pkt.ctrl.reg_write == 1'b1 &&
        (id_ex_pkt.rd == if_rs1 || id_ex_pkt.rd == if_rs2);
    let ex_dep =
        ex_mem_pkt.valid == 1'b1 &&
        ex_mem_pkt.rd != <(5'd0)::reg_idx_t> &&
        ex_mem_pkt.ctrl.reg_write == 1'b1 &&
        (ex_mem_pkt.rd == if_rs1 || ex_mem_pkt.rd == if_rs2);
    if is_ctrl_sensitive == 1'b1 && (id_dep == 1'b1 || ex_dep == 1'b1) {
        1'b1
    } else {
        1'b0
    }
}
