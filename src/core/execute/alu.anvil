// Unified div/rem: prepares operands, calls divu64_full exactly once,
// then selects quotient or remainder with sign correction.
// All 8 RISC-V div/rem variants (DIV/DIVU/REM/REMU and .w forms) go through here.
func do_div_remu(op : alu_op_t, lhs : xlen_t, rhs : xlen_t) {
    // Effective 64-bit operands: .w variants need sign/zero extension
    let eff_a =
        if op == alu_op_t::ALU_DIVW || op == alu_op_t::ALU_REMW {
            call sext32_result(lhs[0+:32])
        } else if op == alu_op_t::ALU_DIVUW || op == alu_op_t::ALU_REMUW {
            <(#flat{32'd0, lhs[0+:32]})::xlen_t>
        } else { lhs };
    let eff_b =
        if op == alu_op_t::ALU_DIVW || op == alu_op_t::ALU_REMW {
            call sext32_result(rhs[0+:32])
        } else if op == alu_op_t::ALU_DIVUW || op == alu_op_t::ALU_REMUW {
            <(#flat{32'd0, rhs[0+:32]})::xlen_t>
        } else { rhs };
    // Signed variants: DIV/REM/DIVW/REMW
    let is_signed =
        op == alu_op_t::ALU_DIV  || op == alu_op_t::ALU_REM ||
        op == alu_op_t::ALU_DIVW || op == alu_op_t::ALU_REMW;
    // Take unsigned magnitude for signed ops
    let abs_a = if is_signed == 1'b1 && eff_a[63] == 1'b1 { <(64'd0)::xlen_t> - eff_a } else { eff_a };
    let abs_b = if is_signed == 1'b1 && eff_b[63] == 1'b1 { <(64'd0)::xlen_t> - eff_b } else { eff_b };
    // Division by zero: per RISC-V spec, quotient=all-ones, remainder=dividend
    let dbz = eff_b == <(64'd0)::xlen_t>;
    // Single call to divu64_full — the only elaboration of the 64-step divider
    let parts =
        if dbz == 1'b1 { mul_parts_t::{ lo = <(64'hffffffffffffffff)::xlen_t>; hi = eff_a } }
        else           { call divu64_full(abs_a, abs_b) };
    let quot = parts.lo;
    let rem  = parts.hi;
    // Select quotient or remainder based on op
    let is_rem =
        op == alu_op_t::ALU_REM  || op == alu_op_t::ALU_REMU ||
        op == alu_op_t::ALU_REMW || op == alu_op_t::ALU_REMUW;
    let raw = if is_rem == 1'b1 { rem } else { quot };
    // Sign correction for signed non-div-by-zero results
    let neg_div = is_signed == 1'b1 && eff_a[63] != eff_b[63];
    let neg_rem = is_signed == 1'b1 && eff_a[63] == 1'b1;
    let need_neg = if is_rem == 1'b1 { neg_rem } else { neg_div };
    let apply_neg = need_neg == 1'b1 && dbz == 1'b0;
    let signed_result = if apply_neg == 1'b1 { <(64'd0)::xlen_t> - raw } else { raw };
    // .w variants: truncate to 32 bits and sign-extend
    let is_w =
        op == alu_op_t::ALU_DIVW  || op == alu_op_t::ALU_DIVUW ||
        op == alu_op_t::ALU_REMW  || op == alu_op_t::ALU_REMUW;
    if is_w == 1'b1 { call sext32_result(signed_result[0+:32]) } else { signed_result }
}

func alu_exec(op : alu_op_t, lhs : xlen_t, rhs : xlen_t) {
    // `result` is the architectural value; `zero` and `negative` are useful
    // side channels for later refinements and branch/control experiments.
    let result =
        if op == alu_op_t::ALU_ADD { lhs + rhs }
        else if op == alu_op_t::ALU_SUB { lhs - rhs }
        else if op == alu_op_t::ALU_AND { lhs & rhs }
        else if op == alu_op_t::ALU_OR { lhs | rhs }
        else if op == alu_op_t::ALU_XOR { lhs ^ rhs }
        else if op == alu_op_t::ALU_SLL { call logical_shl(lhs, rhs) }
        else if op == alu_op_t::ALU_SRL { call logical_shr(lhs, rhs) }
        else if op == alu_op_t::ALU_SRA { call arithmetic_shr(lhs, rhs) }
        else if op == alu_op_t::ALU_SLT { <(#flat{63'd0, call signed_lt(lhs, rhs)})::xlen_t> }
        else if op == alu_op_t::ALU_SLTU { <(#flat{63'd0, call unsigned_lt(lhs, rhs)})::xlen_t> }
        else if op == alu_op_t::ALU_COPY_A { lhs }
        else if op == alu_op_t::ALU_COPY_B { rhs }
        else if op == alu_op_t::ALU_MUL { call mul_low(lhs, rhs) }
        else if op == alu_op_t::ALU_MULH { call mulh(lhs, rhs) }
        else if op == alu_op_t::ALU_MULHSU { call mulhsu(lhs, rhs) }
        else if op == alu_op_t::ALU_MULHU { call mulhu(lhs, rhs) }
        else if op == alu_op_t::ALU_ADDW { call sext32_result(<(lhs[0+:32] + rhs[0+:32])::logic[32]>) }
        else if op == alu_op_t::ALU_SUBW { call sext32_result(<(lhs[0+:32] - rhs[0+:32])::logic[32]>) }
        else if op == alu_op_t::ALU_SLLW {
            let res = call logical_shl_32(lhs, rhs);
            call sext32_result(res[0+:32])
        }
        else if op == alu_op_t::ALU_SRLW {
            let res = call logical_shr_32(lhs, rhs);
            call sext32_result(res[0+:32])
        }
        else if op == alu_op_t::ALU_SRAW {
            let sex32 = call sext32_result(lhs[0+:32]);
            call arithmetic_shr_32(sex32, rhs)
        }
        else if op == alu_op_t::ALU_MULW   { call mulw(lhs, rhs) }
        // DIV/REM are handled by the iterative divider in pipeline_core.
        // Keeping the 64-step divider out of this reachable combinational
        // ALU expression tree prevents Anvil elaboration from exhausting memory.
        else if op == alu_op_t::ALU_DIV   ||
                op == alu_op_t::ALU_DIVU  ||
                op == alu_op_t::ALU_REM   ||
                op == alu_op_t::ALU_REMU  ||
                op == alu_op_t::ALU_DIVW  ||
                op == alu_op_t::ALU_DIVUW ||
                op == alu_op_t::ALU_REMW  ||
                op == alu_op_t::ALU_REMUW { <(64'd0)::xlen_t> }
        else { rhs };
    alu_result_t::{result = result; zero = (result == <(64'd0)::xlen_t>); negative = result[63]}
}
