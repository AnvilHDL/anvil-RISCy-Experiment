    let q15  = <(#flat{q14[0+:63], qb15[0+:1]})::xlen_t>;
    let nr16 = <(#flat{r15[0+:63], q15[63+:1]})::xlen_t>;
    let c16  = if r15[63] == 1'b1 { 1'b1 } else { call unsigned_ge(nr16, b) };
    let r16  = if c16 == 1'b1 { nr16 - b } else { nr16 };
    let qb16 = if c16 == 1'b1 { <(64'd1)::xlen_t> } else { <(64'd0)::xlen_t> };
    let q16  = <(#flat{q15[0+:63], qb16[0+:1]})::xlen_t>;
    let nr17 = <(#flat{r16[0+:63], q16[63+:1]})::xlen_t>;
    let c17  = if r16[63] == 1'b1 { 1'b1 } else { call unsigned_ge(nr17, b) };
    let r17  = if c17 == 1'b1 { nr17 - b } else { nr17 };
