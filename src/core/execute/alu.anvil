    let q17  = <(#flat{q16[0+:63], qb17[0+:1]})::xlen_t>;
    let nr18 = <(#flat{r17[0+:63], q17[63+:1]})::xlen_t>;
    let c18  = if r17[63] == 1'b1 { 1'b1 } else { call unsigned_ge(nr18, b) };
    let r18  = if c18 == 1'b1 { nr18 - b } else { nr18 };
