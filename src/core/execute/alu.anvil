    let q18  = <(#flat{q17[0+:63], qb18[0+:1]})::xlen_t>;
    let nr19 = <(#flat{r18[0+:63], q18[63+:1]})::xlen_t>;
    let c19  = if r18[63] == 1'b1 { 1'b1 } else { call unsigned_ge(nr19, b) };
    let r19  = if c19 == 1'b1 { nr19 - b } else { nr19 };
