    let c12  = if r11[63] == 1'b1 { 1'b1 } else { call unsigned_ge(nr12, b) };
    let r12  = if c12 == 1'b1 { nr12 - b } else { nr12 };
    let qb12 = if c12 == 1'b1 { <(64'd1)::xlen_t> } else { <(64'd0)::xlen_t> };
    let q12  = <(#flat{q11[0+:63], qb12[0+:1]})::xlen_t>;
    let nr13 = <(#flat{r12[0+:63], q12[63+:1]})::xlen_t>;
    let c13  = if r12[63] == 1'b1 { 1'b1 } else { call unsigned_ge(nr13, b) };
    let r13  = if c13 == 1'b1 { nr13 - b } else { nr13 };
