import "../../types/pipeline.anvilh"

// The ALU is pure combinational logic.
//
// W-ops use a 5-bit shift amount and sign-extend 32-bit results.

func signed_lt(lhs : xlen_t, rhs : xlen_t) {
    if lhs[63] != rhs[63] { lhs[63] }
    else { lhs < rhs }
}

func signed_ge(lhs : xlen_t, rhs : xlen_t) {
    if call signed_lt(lhs, rhs) == 1'b1 { 1'b0 } else { 1'b1 }
}

func unsigned_lt(lhs : xlen_t, rhs : xlen_t) {
    if lhs[63] != rhs[63] {
        lhs[63] == 1'b0 && rhs[63] == 1'b1
    } else {
        lhs[0+:63] < rhs[0+:63]
    }
}

func unsigned_ge(lhs : xlen_t, rhs : xlen_t) {
    if call unsigned_lt(lhs, rhs) == 1'b1 { 1'b0 } else { 1'b1 }
}

func shamt6(rhs : xlen_t) {
    rhs[0+:6]
}

func shamt5(rhs : xlen_t) {
    rhs[0+:5]
}

func sext32_result(raw : logic[32]) {
    let base = <(raw)::xlen_t>;
    if raw[31] == 1'b1 { base + <(64'hffffffff00000000)::xlen_t> } else { base }
}

func zext32_to_xlen(v : logic[32]) {
    <(#flat{32'd0, v})::xlen_t>
}

func zext16_to_xlen(v : logic[16]) {
    <(#flat{48'd0, v})::xlen_t>
}

func shr16(v : xlen_t) {
    <(#flat{16'd0, v[16+:48]})::xlen_t>
}

func xlen_from_limbs16(l0 : logic[16], l1 : logic[16], l2 : logic[16], l3 : logic[16]) {
    <(#flat{l3, l2, l1, l0})::xlen_t>
}

struct mul_parts_t {
    lo : xlen_t,
    hi : xlen_t
}


func mul16_u(a : logic[16], b : logic[16]) {
    // Anvil widens `*` to the sum of operand widths, so explicitly slice the
    // low 64 bits back out to keep the helper's type small and predictable.
    let a64 = call zext16_to_xlen(a);
    let b64 = call zext16_to_xlen(b);
    let product = a64 * b64;
    <(product[0+:64])::xlen_t>
}

func mul_u64_parts(lhs : xlen_t, rhs : xlen_t) {
    let a0 = lhs[0+:16];
    let a1 = lhs[16+:16];
    let a2 = lhs[32+:16];
    let a3 = lhs[48+:16];
    let b0 = rhs[0+:16];
    let b1 = rhs[16+:16];
    let b2 = rhs[32+:16];
    let b3 = rhs[48+:16];

    let p00 = call mul16_u(a0, b0);
    let p01 = call mul16_u(a0, b1);
    let p02 = call mul16_u(a0, b2);
    let p03 = call mul16_u(a0, b3);
    let p10 = call mul16_u(a1, b0);
    let p11 = call mul16_u(a1, b1);
    let p12 = call mul16_u(a1, b2);
    let p13 = call mul16_u(a1, b3);
    let p20 = call mul16_u(a2, b0);
    let p21 = call mul16_u(a2, b1);
    let p22 = call mul16_u(a2, b2);
    let p23 = call mul16_u(a2, b3);
    let p30 = call mul16_u(a3, b0);
    let p31 = call mul16_u(a3, b1);
    let p32 = call mul16_u(a3, b2);
    let p33 = call mul16_u(a3, b3);

    let s0 = p00;
    let r0 = s0[0+:16];
    let c0 = call shr16(s0);

    let s1 = c0 + p01 + p10;
    let r1 = s1[0+:16];
    let c1 = call shr16(s1);

    let s2 = c1 + p02 + p11 + p20;
    let r2 = s2[0+:16];
    let c2 = call shr16(s2);

    let s3 = c2 + p03 + p12 + p21 + p30;
    let r3 = s3[0+:16];
    let c3 = call shr16(s3);

    let s4 = c3 + p13 + p22 + p31;
    let r4 = s4[0+:16];
    let c4 = call shr16(s4);

    let s5 = c4 + p23 + p32;
    let r5 = s5[0+:16];
    let c5 = call shr16(s5);

    let s6 = c5 + p33;
    let r6 = s6[0+:16];
    let c6 = call shr16(s6);

    mul_parts_t::{
        lo = call xlen_from_limbs16(r0, r1, r2, r3);
        hi = call xlen_from_limbs16(r4, r5, r6, c6[0+:16])
    }
}

func mul_low(lhs : xlen_t, rhs : xlen_t) {
    let parts = call mul_u64_parts(lhs, rhs);
    parts.lo
}

func mulhu(lhs : xlen_t, rhs : xlen_t) {
    let parts = call mul_u64_parts(lhs, rhs);
    parts.hi
}

func mulhsu(lhs : xlen_t, rhs : xlen_t) {
    let unsigned_hi = call mulhu(lhs, rhs);
    if lhs[63] == 1'b1 { unsigned_hi - rhs } else { unsigned_hi }
}

func mulh(lhs : xlen_t, rhs : xlen_t) {
    let unsigned_hi = call mulhu(lhs, rhs);
    let lhs_corr = if lhs[63] == 1'b1 { rhs } else { <(64'd0)::xlen_t> };
    let rhs_corr = if rhs[63] == 1'b1 { lhs } else { <(64'd0)::xlen_t> };
    unsigned_hi - lhs_corr - rhs_corr
}

func mulw(lhs : xlen_t, rhs : xlen_t) {
    call sext32_result(call mul_low(lhs, rhs)[0+:32])
}

func logical_shl(lhs : xlen_t, rhs : xlen_t) {
    lhs shl <(#flat{58'd0, call shamt6(rhs)})::xlen_t>
}

func logical_shr(lhs : xlen_t, rhs : xlen_t) {
    lhs shr <(#flat{58'd0, call shamt6(rhs)})::xlen_t>
}

func sra_fill_mask_64(rhs : xlen_t) {
    let shamt = <(#flat{58'd0, call shamt6(rhs)})::xlen_t>;
    if call shamt6(rhs) == 6'd0 {
        <(64'd0)::xlen_t>
    } else {
        ~(<(64'hffffffffffffffff)::xlen_t> shr shamt)
    }
}

func arithmetic_shr(lhs : xlen_t, rhs : xlen_t) {
    let logical = lhs shr <(#flat{58'd0, call shamt6(rhs)})::xlen_t>;
    if lhs[63] == 1'b1 { logical | call sra_fill_mask_64(rhs) } else { logical }
}

func logical_shl_32(lhs : xlen_t, rhs : xlen_t) {
    let shamt = <(#flat{59'd0, call shamt5(rhs)})::xlen_t>;
    let word = <(#flat{32'd0, lhs[0+:32]})::xlen_t>;
    word shl shamt
}

func logical_shr_32(lhs : xlen_t, rhs : xlen_t) {
    let shamt = <(#flat{59'd0, call shamt5(rhs)})::xlen_t>;
    let word = <(#flat{32'd0, lhs[0+:32]})::xlen_t>;
    word shr shamt
}

func sra_fill_mask_32(rhs : xlen_t) {
    let shamt = <(#flat{59'd0, call shamt5(rhs)})::xlen_t>;
    if call shamt5(rhs) == 5'd0 {
        <(64'd0)::xlen_t>
    } else {
        ~(<(64'hffffffffffffffff)::xlen_t> shr shamt)
    }
}

func arithmetic_shr_32(lhs : xlen_t, rhs : xlen_t) {
    let shamt = <(#flat{59'd0, call shamt5(rhs)})::xlen_t>;
    let logical = lhs shr shamt;
    if lhs[63] == 1'b1 { logical | call sra_fill_mask_32(rhs) } else { logical }
}

// ---- Division: flat 64-step restoring binary divider ----
// Single function; all 64 steps are plain let bindings so the Anvil
// elaborator never copies an AST subtree more than once.
// Returns mul_parts_t::{ lo = quotient; hi = remainder }.
func divu64_full(a : xlen_t, b : xlen_t) {
    let q0 = a;
    let r0 = <(64'd0)::xlen_t>;
    let nr1 = <(#flat{r0[0+:63], q0[63+:1]})::xlen_t>;
    let c1  = if r0[63] == 1'b1 { 1'b1 } else { call unsigned_ge(nr1, b) };
    let r1  = if c1 == 1'b1 { nr1 - b } else { nr1 };
    let qb1 = if c1 == 1'b1 { <(64'd1)::xlen_t> } else { <(64'd0)::xlen_t> };
    let q1  = <(#flat{q0[0+:63], qb1[0+:1]})::xlen_t>;
    let nr2 = <(#flat{r1[0+:63], q1[63+:1]})::xlen_t>;
    let c2  = if r1[63] == 1'b1 { 1'b1 } else { call unsigned_ge(nr2, b) };
    let r2  = if c2 == 1'b1 { nr2 - b } else { nr2 };
    let qb2 = if c2 == 1'b1 { <(64'd1)::xlen_t> } else { <(64'd0)::xlen_t> };
    let q2  = <(#flat{q1[0+:63], qb2[0+:1]})::xlen_t>;
    let nr3 = <(#flat{r2[0+:63], q2[63+:1]})::xlen_t>;
    let c3  = if r2[63] == 1'b1 { 1'b1 } else { call unsigned_ge(nr3, b) };
    let r3  = if c3 == 1'b1 { nr3 - b } else { nr3 };
    let qb3 = if c3 == 1'b1 { <(64'd1)::xlen_t> } else { <(64'd0)::xlen_t> };
    let q3  = <(#flat{q2[0+:63], qb3[0+:1]})::xlen_t>;
    let nr4 = <(#flat{r3[0+:63], q3[63+:1]})::xlen_t>;
    let c4  = if r3[63] == 1'b1 { 1'b1 } else { call unsigned_ge(nr4, b) };
    let r4  = if c4 == 1'b1 { nr4 - b } else { nr4 };
    let qb4 = if c4 == 1'b1 { <(64'd1)::xlen_t> } else { <(64'd0)::xlen_t> };
    let q4  = <(#flat{q3[0+:63], qb4[0+:1]})::xlen_t>;
    let nr5 = <(#flat{r4[0+:63], q4[63+:1]})::xlen_t>;
    let c5  = if r4[63] == 1'b1 { 1'b1 } else { call unsigned_ge(nr5, b) };
    let r5  = if c5 == 1'b1 { nr5 - b } else { nr5 };
    let qb5 = if c5 == 1'b1 { <(64'd1)::xlen_t> } else { <(64'd0)::xlen_t> };
    let q5  = <(#flat{q4[0+:63], qb5[0+:1]})::xlen_t>;
    let nr6 = <(#flat{r5[0+:63], q5[63+:1]})::xlen_t>;
    let c6  = if r5[63] == 1'b1 { 1'b1 } else { call unsigned_ge(nr6, b) };
    let r6  = if c6 == 1'b1 { nr6 - b } else { nr6 };
    let qb6 = if c6 == 1'b1 { <(64'd1)::xlen_t> } else { <(64'd0)::xlen_t> };
    let q6  = <(#flat{q5[0+:63], qb6[0+:1]})::xlen_t>;
    let nr7 = <(#flat{r6[0+:63], q6[63+:1]})::xlen_t>;
    let c7  = if r6[63] == 1'b1 { 1'b1 } else { call unsigned_ge(nr7, b) };
    let r7  = if c7 == 1'b1 { nr7 - b } else { nr7 };
    let qb7 = if c7 == 1'b1 { <(64'd1)::xlen_t> } else { <(64'd0)::xlen_t> };
    let q7  = <(#flat{q6[0+:63], qb7[0+:1]})::xlen_t>;
    let nr8 = <(#flat{r7[0+:63], q7[63+:1]})::xlen_t>;
    let c8  = if r7[63] == 1'b1 { 1'b1 } else { call unsigned_ge(nr8, b) };
    let r8  = if c8 == 1'b1 { nr8 - b } else { nr8 };
    let qb8 = if c8 == 1'b1 { <(64'd1)::xlen_t> } else { <(64'd0)::xlen_t> };
    let q8  = <(#flat{q7[0+:63], qb8[0+:1]})::xlen_t>;
    let nr9 = <(#flat{r8[0+:63], q8[63+:1]})::xlen_t>;
    let c9  = if r8[63] == 1'b1 { 1'b1 } else { call unsigned_ge(nr9, b) };
    let r9  = if c9 == 1'b1 { nr9 - b } else { nr9 };
    let qb9 = if c9 == 1'b1 { <(64'd1)::xlen_t> } else { <(64'd0)::xlen_t> };
    let q9  = <(#flat{q8[0+:63], qb9[0+:1]})::xlen_t>;
    let nr10 = <(#flat{r9[0+:63], q9[63+:1]})::xlen_t>;
    let c10  = if r9[63] == 1'b1 { 1'b1 } else { call unsigned_ge(nr10, b) };
    let r10  = if c10 == 1'b1 { nr10 - b } else { nr10 };
    let qb10 = if c10 == 1'b1 { <(64'd1)::xlen_t> } else { <(64'd0)::xlen_t> };
    let q10  = <(#flat{q9[0+:63], qb10[0+:1]})::xlen_t>;
    let nr11 = <(#flat{r10[0+:63], q10[63+:1]})::xlen_t>;
    let c11  = if r10[63] == 1'b1 { 1'b1 } else { call unsigned_ge(nr11, b) };
    let r11  = if c11 == 1'b1 { nr11 - b } else { nr11 };
    let qb11 = if c11 == 1'b1 { <(64'd1)::xlen_t> } else { <(64'd0)::xlen_t> };
