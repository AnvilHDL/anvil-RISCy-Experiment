    let nr15 = <(#flat{r14[0+:63], q14[63+:1]})::xlen_t>;
    let c15  = if r14[63] == 1'b1 { 1'b1 } else { call unsigned_ge(nr15, b) };
    let r15  = if c15 == 1'b1 { nr15 - b } else { nr15 };
