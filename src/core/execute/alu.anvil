    let q28  = <(#flat{q27[0+:63], qb28[0+:1]})::xlen_t>;
    let nr29 = <(#flat{r28[0+:63], q28[63+:1]})::xlen_t>;
    let c29  = if r28[63] == 1'b1 { 1'b1 } else { call unsigned_ge(nr29, b) };
    let r29  = if c29 == 1'b1 { nr29 - b } else { nr29 };
    let qb29 = if c29 == 1'b1 { <(64'd1)::xlen_t> } else { <(64'd0)::xlen_t> };
    let q29  = <(#flat{q28[0+:63], qb29[0+:1]})::xlen_t>;
    let nr30 = <(#flat{r29[0+:63], q29[63+:1]})::xlen_t>;
    let c30  = if r29[63] == 1'b1 { 1'b1 } else { call unsigned_ge(nr30, b) };
    let r30  = if c30 == 1'b1 { nr30 - b } else { nr30 };
